# Optional overrides for infra/docker-compose.yml.
# The compose file already has local defaults, so copying this file is only
# needed when you want to point the API at a different image provider.

LABHAUS_IMAGE_PROVIDER_BASE_URL=http://mock-image-provider:8089
LABHAUS_IMAGE_PROVIDER_API_KEY=dev-mock-key
MOCK_IMAGE_PROVIDER_PUBLIC_BASE_URL=http://mock-image-provider:8089
